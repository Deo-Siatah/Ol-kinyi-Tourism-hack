{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "npx vitest*": "allow",
      "rm -rf *": "deny",
      "git push*": "deny"
    },
    "external_directory": {
      "~/secrets/**": "deny",
      "*": "ask"
    }
  }
}
